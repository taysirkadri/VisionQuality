# Select "fake" for a dependency-free demo, "ultralytics" for PyTorch/YOLOv8,
# or "onnx" for ONNX Runtime. Use "onnx-tensorrt" for TensorRT/CUDA acceleration.
# Missing real-model setup automatically falls back to fake except for TensorRT mode.
DEFECT_BACKEND=fake
DEFECT_MODEL_PATH=models/best.pt
DEFECT_CONFIDENCE=0.35
DEFECT_IOU=0.45
DEFECT_IMAGE_SIZE=640
DEFECT_MAX_UPLOAD_BYTES=10485760
DEFECT_TENSORRT_FP16=true
DEFECT_TENSORRT_DEVICE_ID=0
DEFECT_TENSORRT_MAX_WORKSPACE_MB=2048
DEFECT_TENSORRT_ENGINE_CACHE=models/tensorrt
DEFECT_TENSORRT_TIMING_CACHE=models/tensorrt
DEFECT_PROVIDER_FALLBACK=true
DEFECT_WARMUP_REQUESTS=10
DEFECT_MAX_BATCH_SIZE=1
# Optional comma-separated labels. Defaults to the six NEU steel classes.
# DEFECT_CLASS_NAMES=crazing,inclusion,patches,pitted_surface,rolled-in_scale,scratches

