FROM nvcr.io/nvidia/tensorrt:24.10-py3

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends libglib2.0-0 libgl1 && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml requirements.txt ./
COPY src ./src
RUN pip install --upgrade pip && pip install -e ".[dashboard,tensorrt]"
COPY . .

ENV DEFECT_BACKEND=onnx-tensorrt
ENV DEFECT_MODEL_PATH=/app/models/best.onnx
ENV DEFECT_PROVIDER_FALLBACK=true

EXPOSE 8000
CMD ["uvicorn", "industrial_defect_detection.api:app", "--host", "0.0.0.0", "--port", "8000"]
